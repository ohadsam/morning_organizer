<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sentence_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"
        android:src="@drawable/wbg_sentence" android:importantForAccessibility="no"/>
    <LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="14dp">
    <TextView android:id="@+id/sentence_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="4" android:ellipsize="end"/>
    <TextView android:id="@+id/sentence_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp"
        android:textColor="@color/widget_text" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</FrameLayout>
